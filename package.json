{
  "name": "conductor-film-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "backend-realtime",
    "web-client"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:backend": "npm run dev --workspace backend-realtime",
    "dev:web": "npm run dev --workspace web-client"
  }
}
